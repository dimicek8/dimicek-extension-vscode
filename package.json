    },
    "configuration": {
      "title": "Dimicek",
      "properties": {
        "dimicek.changes.groupByDirectory": {
          "type": "boolean",
          "default": true,
          "description": "Group files in the Changes view by directory."
        },
        "dimicek.update.method": {
          "type": "string",
          "enum": [
            "ask",
            "merge",
            "rebase"
          ],
          "enumDescriptions": [
            "Ask every time",
            "Merge the upstream branch into the current branch",
            "Rebase the current branch onto the upstream branch"
          ],
          "default": "ask",
          "description": "How Update Project applies upstream changes."
        },
        "dimicek.fetch.autoFetchInterval": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Fetch all remotes in the background every N minutes. 0 turns automatic fetch off."
        },
        "dimicek.branches.popupStyle": {
          "type": "string",
          "enum": [
            "window",
            "quickPick"
          ],
          "enumDescriptions": [
            "Open the Branches window in the editor area",
            "Open the compact quick pick at the top of the window"
          ],
          "default": "window",
          "description": "What clicking the branch in the status bar opens."
        }
      }
    },
    "keybindings": [
      {
        "command": "dimicek.changes.showDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "focusedView == dimicek.changes"
      },
      {
        "command": "dimicek.changes.openFile",
        "key": "f4",
        "when": "focusedView == dimicek.changes"
      },
      {
        "command": "dimicek.changes.rollback",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "focusedView == dimicek.changes"
      },
      {
        "command": "dimicek.changes.addToVcs",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "focusedView == dimicek.changes"
      },
      {
        "command": "dimicek.changes.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == dimicek.changes"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build": "npm run check-types && node esbuild.mjs && vite build --config webview-ui/vite.config.mts",
