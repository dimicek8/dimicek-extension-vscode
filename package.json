{
  "name": "dimicek",
  "displayName": "Dimicek",
  "description": "Git & GitHub workflow inspired by IntelliJ IDEA: commit window, log with graph, branches popup and more.",
  "version": "0.0.1",
  "publisher": "dimicek",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dimicek8/dimicek-extension-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/dimicek8/dimicek-extension-vscode/issues"
  },
  "homepage": "https://github.com/dimicek8/dimicek-extension-vscode#readme",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "github",
    "intellij",
    "log",
    "commit",
    "branches"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dimicek.changes.refresh",
        "title": "Refresh",
        "category": "Dimicek",
        "icon": "$(refresh)"
      },
      {
        "command": "dimicek.changes.groupByDirectory",
        "title": "Group by Directory",
        "category": "Dimicek",
        "icon": "$(list-tree)"
      },
      {
        "command": "dimicek.changes.showFlat",
        "title": "Show as Flat List",
        "category": "Dimicek",
        "icon": "$(list-flat)"
      },
      {
        "command": "dimicek.changes.showDiff",
        "title": "Show Diff",
        "category": "Dimicek",
        "icon": "$(diff)"
      },
      {
        "command": "dimicek.changes.openFile",
        "title": "Open File",
        "category": "Dimicek",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dimicek.changes.rollback",
        "title": "Rollback…",
        "category": "Dimicek",
        "icon": "$(discard)"
      },
      {
        "command": "dimicek.changes.addToVcs",
        "title": "Add to VCS",
        "category": "Dimicek",
        "icon": "$(add)"
      },
      {
        "command": "dimicek.changes.ignore",
        "title": "Add to .gitignore…",
        "category": "Dimicek"
      },
      {
        "command": "dimicek.changes.delete",
        "title": "Delete…",
        "category": "Dimicek",
        "icon": "$(trash)"
      },
      {
        "command": "dimicek.branches.show",
        "title": "Branches…",
        "category": "Dimicek",
        "icon": "$(git-branch)"
      },
      {
        "command": "dimicek.branches.newBranch",
        "title": "New Branch…",
        "category": "Dimicek"
      },
      {
        "command": "dimicek.branches.checkoutRevision",
        "title": "Checkout Tag or Revision…",
        "category": "Dimicek"
      },
      {
        "command": "dimicek.branches.fetch",
        "title": "Fetch",
        "category": "Dimicek",
        "icon": "$(sync)"
      },
      {
        "command": "dimicek.changes.markResolved",
        "title": "Mark as Resolved",
        "category": "Dimicek",
        "icon": "$(check)"
      },
      {
        "command": "dimicek.log.show",
        "title": "Show Git Log",
        "category": "Dimicek"
      },
      {
        "command": "dimicek.log.refresh",
        "title": "Refresh Log",
        "category": "Dimicek",
        "icon": "$(refresh)"
      },
      {
        "command": "dimicek.log.copyRevision",
        "title": "Copy Revision Number",
        "category": "Dimicek",
        "icon": "$(copy)"
      },
      {
        "command": "dimicek.log.newBranch",
        "title": "New Branch…",
        "category": "Dimicek",
        "icon": "$(git-branch)"
      },
      {
        "command": "dimicek.log.newTag",
        "title": "New Tag…",
        "category": "Dimicek",
        "icon": "$(tag)"
      },
      {
        "command": "dimicek.log.checkoutRevision",
        "title": "Checkout Revision",
        "category": "Dimicek",
        "icon": "$(check)"
      },
      {
        "command": "dimicek.log.cherryPick",
        "title": "Cherry-Pick",
        "category": "Dimicek",
        "icon": "$(git-commit)"
      },
      {
        "command": "dimicek.log.revert",
        "title": "Revert Commit",
        "category": "Dimicek",
        "icon": "$(discard)"
      },
      {
        "command": "dimicek.log.reset",
        "title": "Reset Current Branch to Here…",
        "category": "Dimicek",
        "icon": "$(history)"
      },
      {
        "command": "dimicek.log.compareWithLocal",
        "title": "Compare with Local",
        "category": "Dimicek",
        "icon": "$(git-compare)"
      },
      {
        "command": "dimicek.push.show",
        "title": "Push…",
        "category": "Dimicek",
        "icon": "$(repo-push)"
      },
      {
        "command": "dimicek.update.project",
        "title": "Update Project…",
        "category": "Dimicek",
        "icon": "$(repo-pull)"
      },
      {
        "command": "dimicek.log.showHistory",
        "title": "Show History",
        "category": "Dimicek",
        "icon": "$(history)"
      },
      {
        "command": "dimicek.blame.toggle",
        "title": "Annotate with Git Blame",
        "category": "Dimicek",
        "icon": "$(person)"
      },
      {
        "command": "dimicek.blame.close",
        "title": "Close Annotations",
        "category": "Dimicek",
        "icon": "$(close)"
      },
      {
        "command": "dimicek.blame.showCommitOfLine",
        "title": "Show Commit of This Line in Git Log",
        "category": "Dimicek"
      },
      {
        "command": "dimicek.blame.copyHash",
        "title": "Copy Commit Hash",
        "category": "Dimicek"
      },
      {
        "command": "dimicek.log.revealCommit",
        "title": "Show Commit in Git Log",
        "category": "Dimicek"
      },
      {
        "command": "dimicek.compare.withBranch",
        "title": "Compare with Branch…",
        "category": "Dimicek",
        "icon": "$(git-compare)"
      },
      {
        "command": "dimicek.compare.withRevision",
        "title": "Compare with Revision…",
        "category": "Dimicek",
        "icon": "$(git-compare)"
      },
      {
        "command": "dimicek.stash.stash",
        "title": "Stash Changes…",
        "category": "Dimicek",
        "icon": "$(archive)"
      },
      {
        "command": "dimicek.stash.refresh",
        "title": "Refresh Stashes",
        "category": "Dimicek",
        "icon": "$(refresh)"
      },
      {
        "command": "dimicek.stash.clear",
        "title": "Clear Stashes…",
        "category": "Dimicek",
        "icon": "$(clear-all)"
      },
      {
        "command": "dimicek.stash.apply",
        "title": "Apply Stash",
        "category": "Dimicek",
        "icon": "$(check)"
      },
      {
        "command": "dimicek.stash.pop",
        "title": "Pop Stash",
        "category": "Dimicek",
        "icon": "$(git-stash-pop)"
      },
      {
        "command": "dimicek.stash.drop",
        "title": "Drop Stash…",
        "category": "Dimicek",
        "icon": "$(trash)"
      },
      {
        "command": "dimicek.stash.branch",
        "title": "Unstash as Branch…",
        "category": "Dimicek",
        "icon": "$(git-branch)"
      },
      {
        "command": "dimicek.stash.showDiff",
        "title": "Show Diff",
        "category": "Dimicek"
      },
      {
        "command": "dimicek.conflicts.resolve",
        "title": "Resolve Conflicts…",
        "category": "Dimicek",
        "icon": "$(git-merge)"
      },
      {
        "command": "dimicek.conflicts.acceptYours",
        "title": "Accept Yours",
        "category": "Dimicek",
        "icon": "$(arrow-left)"
      },
      {
        "command": "dimicek.conflicts.acceptTheirs",
        "title": "Accept Theirs",
        "category": "Dimicek",
        "icon": "$(arrow-right)"
      },
      {
        "command": "dimicek.conflicts.openMergeEditor",
        "title": "Open in Merge Editor",
        "category": "Dimicek",
        "icon": "$(git-merge)"
      },
      {
        "command": "dimicek.log.interactiveRebase",
        "title": "Interactively Rebase from Here…",
        "category": "Dimicek",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "dimicek.tags.push",
        "title": "Push Tags…",
        "category": "Dimicek",
        "icon": "$(tag)"
      },
      {
        "command": "dimicek.tags.delete",
        "title": "Delete Tag…",
        "category": "Dimicek",
        "icon": "$(trash)"
      },
      {
        "command": "dimicek.tags.pushOne",
        "title": "Push Tag",
        "category": "Dimicek",
        "icon": "$(repo-push)"
      },
      {
        "command": "dimicek.tags.deleteOne",
        "title": "Delete Tag…",
        "category": "Dimicek",
        "icon": "$(trash)"
      },
      {
        "command": "dimicek.github.createPullRequest",
        "title": "Create Pull Request…",
        "category": "Dimicek",
        "icon": "$(git-pull-request-create)"
      },
      {
        "command": "dimicek.github.pullRequests",
        "title": "Pull Requests…",
        "category": "Dimicek",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "dimicek.branches.showWindow",
        "title": "Branches (Window)",
        "category": "Dimicek",
        "icon": "$(git-branch)"
      },
      {
        "command": "dimicek.branches.showQuickPick",
        "title": "Branches (Quick Pick)",
        "category": "Dimicek",
        "icon": "$(git-branch)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dimicek",
          "title": "Dimicek",
          "icon": "media/dimicek.svg"
        }
      ],
      "panel": [
        {
          "id": "dimicek-log",
          "title": "Git Log",
          "icon": "media/dimicek.svg"
        }
      ]
    },
    "views": {
      "dimicek": [
        {
          "id": "dimicek.changes",
          "name": "Changes"
        },
        {
          "type": "webview",
          "id": "dimicek.commit",
          "name": "Commit"
        },
        {
          "id": "dimicek.stashes",
          "name": "Stashes",
          "visibility": "collapsed"
        }
      ],
      "dimicek-log": [
        {
          "type": "webview",
          "id": "dimicek.log",
          "name": "Log"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dimicek.changes",
        "contents": "No changes.",
        "when": "dimicek.hasRepository"
      },
      {
        "view": "dimicek.changes",
        "contents": "No Git repository found. Open a folder that contains a Git repository.",
        "when": "!dimicek.hasRepository"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dimicek.changes.refresh",
          "when": "view == dimicek.changes",
          "group": "navigation@2"
        },
        {
          "command": "dimicek.changes.groupByDirectory",
          "when": "view == dimicek.changes && !dimicek.changes.groupedByDirectory",
          "group": "navigation@1"
        },
        {
          "command": "dimicek.changes.showFlat",
          "when": "view == dimicek.changes && dimicek.changes.groupedByDirectory",
          "group": "navigation@1"
        },
        {
          "command": "dimicek.branches.show",
          "when": "view == dimicek.changes",
          "group": "navigation@0"
        },
        {
          "command": "dimicek.log.refresh",
          "when": "view == dimicek.log",
          "group": "navigation"
        },
        {
          "command": "dimicek.push.show",
          "when": "view == dimicek.changes",
          "group": "navigation@0"
        },
        {
          "command": "dimicek.update.project",
          "when": "view == dimicek.changes",
          "group": "navigation@0"
        },
        {
          "command": "dimicek.stash.stash",
          "when": "view == dimicek.stashes",
          "group": "navigation@1"
        },
        {
          "command": "dimicek.stash.refresh",
          "when": "view == dimicek.stashes",
          "group": "navigation@2"
        },
        {
          "command": "dimicek.stash.clear",
          "when": "view == dimicek.stashes && dimicek.hasStashes",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "dimicek.changes.refresh",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.changes.groupByDirectory",
          "when": "dimicek.hasRepository && !dimicek.changes.groupedByDirectory"
        },
        {
          "command": "dimicek.changes.showFlat",
          "when": "dimicek.hasRepository && dimicek.changes.groupedByDirectory"
        },
        {
          "command": "dimicek.changes.showDiff",
          "when": "false"
        },
        {
          "command": "dimicek.changes.openFile",
          "when": "false"
        },
        {
          "command": "dimicek.changes.rollback",
          "when": "false"
        },
        {
          "command": "dimicek.changes.addToVcs",
          "when": "false"
        },
        {
          "command": "dimicek.changes.ignore",
          "when": "false"
        },
        {
          "command": "dimicek.changes.delete",
          "when": "false"
        },
        {
          "command": "dimicek.branches.show",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.branches.newBranch",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.branches.checkoutRevision",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.branches.fetch",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.changes.markResolved",
          "when": "false"
        },
        {
          "command": "dimicek.log.show",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.log.refresh",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.log.copyRevision",
          "when": "false"
        },
        {
          "command": "dimicek.log.newBranch",
          "when": "false"
        },
        {
          "command": "dimicek.log.newTag",
          "when": "false"
        },
        {
          "command": "dimicek.log.checkoutRevision",
          "when": "false"
        },
        {
          "command": "dimicek.log.cherryPick",
          "when": "false"
        },
        {
          "command": "dimicek.log.revert",
          "when": "false"
        },
        {
          "command": "dimicek.log.reset",
          "when": "false"
        },
        {
          "command": "dimicek.log.compareWithLocal",
          "when": "false"
        },
        {
          "command": "dimicek.push.show",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.update.project",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.log.showHistory",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.blame.toggle",
          "when": "dimicek.hasRepository && resourceScheme == file && !dimicek.blameActive"
        },
        {
          "command": "dimicek.blame.close",
          "when": "dimicek.blameActive"
        },
        {
          "command": "dimicek.blame.showCommitOfLine",
          "when": "dimicek.hasRepository && resourceScheme == file"
        },
        {
          "command": "dimicek.blame.copyHash",
          "when": "false"
        },
        {
          "command": "dimicek.log.revealCommit",
          "when": "false"
        },
        {
          "command": "dimicek.compare.withBranch",
          "when": "dimicek.hasRepository && resourceScheme == file"
        },
        {
          "command": "dimicek.compare.withRevision",
          "when": "dimicek.hasRepository && resourceScheme == file"
        },
        {
          "command": "dimicek.stash.stash",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.stash.clear",
          "when": "dimicek.hasStashes"
        },
        {
          "command": "dimicek.stash.refresh",
          "when": "false"
        },
        {
          "command": "dimicek.stash.apply",
          "when": "false"
        },
        {
          "command": "dimicek.stash.pop",
          "when": "false"
        },
        {
          "command": "dimicek.stash.drop",
          "when": "false"
        },
        {
          "command": "dimicek.stash.branch",
          "when": "false"
        },
        {
          "command": "dimicek.stash.showDiff",
          "when": "false"
        },
        {
          "command": "dimicek.conflicts.resolve",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.conflicts.acceptYours",
          "when": "false"
        },
        {
          "command": "dimicek.conflicts.acceptTheirs",
          "when": "false"
        },
        {
          "command": "dimicek.conflicts.openMergeEditor",
          "when": "false"
        },
        {
          "command": "dimicek.log.interactiveRebase",
          "when": "false"
        },
        {
          "command": "dimicek.tags.push",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.tags.delete",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.tags.pushOne",
          "when": "false"
        },
        {
          "command": "dimicek.tags.deleteOne",
          "when": "false"
        },
        {
          "command": "dimicek.github.createPullRequest",
          "when": "dimicek.hasGitHubRemote"
        },
        {
          "command": "dimicek.github.pullRequests",
          "when": "dimicek.hasGitHubRemote"
        },
        {
          "command": "dimicek.branches.showWindow",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.branches.showQuickPick",
          "when": "dimicek.hasRepository"
        }
      ],
      "view/item/context": [
        {
          "command": "dimicek.changes.rollback",
          "when": "view == dimicek.changes && viewItem =~ /^file:(modified|added|deleted|renamed)$/",
          "group": "inline"
        },
        {
          "command": "dimicek.changes.addToVcs",
          "when": "view == dimicek.changes && viewItem == file:unversioned",
          "group": "inline"
        },
        {
          "command": "dimicek.changes.markResolved",
          "when": "view == dimicek.changes && viewItem == file:conflicted",
          "group": "inline"
        },
        {
          "command": "dimicek.changes.showDiff",
          "when": "view == dimicek.changes && viewItem =~ /^file:/",
          "group": "navigation@1"
        },
        {
          "command": "dimicek.changes.openFile",
          "when": "view == dimicek.changes && viewItem =~ /^file:(modified|added|renamed|unversioned|conflicted)$/",
          "group": "navigation@2"
        },
        {
          "command": "dimicek.changes.rollback",
          "when": "view == dimicek.changes && viewItem =~ /^(file:(modified|added|deleted|renamed)|group:changes|directory:changes)$/",
          "group": "1_modification@1"
        },
        {
          "command": "dimicek.changes.addToVcs",
          "when": "view == dimicek.changes && viewItem =~ /^(file|group|directory):unversioned$/",
          "group": "1_modification@2"
        },
        {
          "command": "dimicek.changes.ignore",
          "when": "view == dimicek.changes && viewItem =~ /^(file|directory):unversioned$/",
          "group": "1_modification@3"
        },
        {
          "command": "dimicek.changes.delete",
          "when": "view == dimicek.changes && viewItem =~ /^file:(modified|added|renamed|unversioned|conflicted)$/",
          "group": "2_delete@1"
        },
        {
          "command": "dimicek.changes.markResolved",
          "when": "view == dimicek.changes && viewItem =~ /^(file:conflicted|group:conflicts|directory:conflicts)$/",
          "group": "1_modification@0"
        },
        {
          "command": "dimicek.stash.pop",
          "when": "view == dimicek.stashes && viewItem == stash",
          "group": "inline@1"
        },
        {
          "command": "dimicek.stash.apply",
          "when": "view == dimicek.stashes && viewItem == stash",
          "group": "1_apply@1"
        },
        {
          "command": "dimicek.stash.pop",
          "when": "view == dimicek.stashes && viewItem == stash",
          "group": "1_apply@2"
        },
        {
          "command": "dimicek.stash.branch",
          "when": "view == dimicek.stashes && viewItem == stash",
          "group": "2_branch@1"
        },
        {
          "command": "dimicek.stash.drop",
          "when": "view == dimicek.stashes && viewItem == stash",
          "group": "3_drop@1"
        },
        {
          "command": "dimicek.conflicts.resolve",
          "when": "view == dimicek.changes && viewItem == group:conflicts",
          "group": "inline@0"
        },
        {
          "command": "dimicek.conflicts.resolve",
          "when": "view == dimicek.changes && viewItem =~ /^(file:conflicted|group:conflicts|directory:conflicts)$/",
          "group": "0_conflicts@0"
        },
        {
          "command": "dimicek.conflicts.openMergeEditor",
          "when": "view == dimicek.changes && viewItem == file:conflicted",
          "group": "0_conflicts@1"
        },
        {
          "command": "dimicek.conflicts.acceptYours",
          "when": "view == dimicek.changes && viewItem =~ /^(file:conflicted|group:conflicts|directory:conflicts)$/",
          "group": "0_conflicts@2"
        },
        {
          "command": "dimicek.conflicts.acceptTheirs",
          "when": "view == dimicek.changes && viewItem =~ /^(file:conflicted|group:conflicts|directory:conflicts)$/",
          "group": "0_conflicts@3"
        }
      ],
      "webview/context": [
        {
          "command": "dimicek.log.copyRevision",
          "when": "webviewId == dimicek.log && webviewSection == commit",
          "group": "1_copy@1"
        },
        {
          "command": "dimicek.log.newBranch",
          "when": "webviewId == dimicek.log && webviewSection == commit",
          "group": "2_create@1"
        },
        {
          "command": "dimicek.log.newTag",
          "when": "webviewId == dimicek.log && webviewSection == commit",
          "group": "2_create@2"
        },
        {
          "command": "dimicek.log.checkoutRevision",
          "when": "webviewId == dimicek.log && webviewSection == commit",
          "group": "3_checkout@1"
        },
        {
          "command": "dimicek.log.cherryPick",
          "when": "webviewId == dimicek.log && webviewSection == commit && !merge",
          "group": "4_apply@1"
        },
        {
          "command": "dimicek.log.revert",
          "when": "webviewId == dimicek.log && webviewSection == commit && !merge",
          "group": "4_apply@2"
        },
        {
          "command": "dimicek.log.reset",
          "when": "webviewId == dimicek.log && webviewSection == commit",
          "group": "5_reset@1"
        },
        {
          "command": "dimicek.log.compareWithLocal",
          "when": "webviewId == dimicek.log && webviewSection == commit",
          "group": "6_compare@1"
        },
        {
          "command": "dimicek.log.interactiveRebase",
          "when": "webviewId == dimicek.log && webviewSection == commit && !merge",
          "group": "5_reset@2"
        },
        {
          "command": "dimicek.tags.pushOne",
          "when": "webviewId == dimicek.log && webviewSection == tag",
          "group": "1_tag@1"
        },
        {
          "command": "dimicek.tags.deleteOne",
          "when": "webviewId == dimicek.log && webviewSection == tag",
          "group": "1_tag@2"
        }
      ],
      "explorer/context": [
        {
          "command": "dimicek.log.showHistory",
          "when": "dimicek.hasRepository && resourceScheme == file",
          "group": "7_dimicek@1"
        },
        {
