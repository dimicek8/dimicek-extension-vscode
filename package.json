{
  "name": "dimicek",
  "displayName": "Dimicek",
  "description": "Git & GitHub workflow inspired by IntelliJ IDEA: commit window, log with graph, branches popup and more.",
  "version": "0.0.1",
  "publisher": "dimicek",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dimicek8/dimicek-extension-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/dimicek8/dimicek-extension-vscode/issues"
  },
  "homepage": "https://github.com/dimicek8/dimicek-extension-vscode#readme",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "github",
    "intellij",
    "log",
    "commit",
    "branches"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dimicek.changes.refresh",
        "title": "Refresh",
        "category": "Dimicek",
        "icon": "$(refresh)"
      },
      {
        "command": "dimicek.changes.groupByDirectory",
        "title": "Group by Directory",
        "category": "Dimicek",
        "icon": "$(list-tree)"
      },
      {
        "command": "dimicek.changes.showFlat",
        "title": "Show as Flat List",
        "category": "Dimicek",
        "icon": "$(list-flat)"
      },
      {
        "command": "dimicek.changes.showDiff",
        "title": "Show Diff",
        "category": "Dimicek",
        "icon": "$(diff)"
      },
      {
        "command": "dimicek.changes.openFile",
        "title": "Open File",
        "category": "Dimicek",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dimicek.changes.rollback",
        "title": "Rollback…",
        "category": "Dimicek",
        "icon": "$(discard)"
      },
      {
        "command": "dimicek.changes.addToVcs",
        "title": "Add to VCS",
        "category": "Dimicek",
        "icon": "$(add)"
      },
      {
        "command": "dimicek.changes.ignore",
        "title": "Add to .gitignore…",
        "category": "Dimicek"
      },
      {
        "command": "dimicek.changes.delete",
        "title": "Delete…",
        "category": "Dimicek",
        "icon": "$(trash)"
      },
      {
        "command": "dimicek.branches.show",
        "title": "Branches…",
        "category": "Dimicek",
        "icon": "$(git-branch)"
      },
      {
        "command": "dimicek.branches.newBranch",
        "title": "New Branch…",
        "category": "Dimicek"
      },
      {
        "command": "dimicek.branches.checkoutRevision",
        "title": "Checkout Tag or Revision…",
        "category": "Dimicek"
      },
      {
        "command": "dimicek.branches.fetch",
        "title": "Fetch",
        "category": "Dimicek",
        "icon": "$(sync)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dimicek",
          "title": "Dimicek",
          "icon": "media/dimicek.svg"
        }
      ]
    },
    "views": {
      "dimicek": [
        {
          "id": "dimicek.changes",
          "name": "Changes"
        },
        {
          "type": "webview",
          "id": "dimicek.commit",
          "name": "Commit"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dimicek.changes",
        "contents": "No changes.",
        "when": "dimicek.hasRepository"
      },
      {
        "view": "dimicek.changes",
        "contents": "No Git repository found. Open a folder that contains a Git repository.",
        "when": "!dimicek.hasRepository"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dimicek.changes.refresh",
          "when": "view == dimicek.changes",
          "group": "navigation@2"
        },
        {
          "command": "dimicek.changes.groupByDirectory",
          "when": "view == dimicek.changes && !dimicek.changes.groupedByDirectory",
          "group": "navigation@1"
        },
        {
          "command": "dimicek.changes.showFlat",
          "when": "view == dimicek.changes && dimicek.changes.groupedByDirectory",
          "group": "navigation@1"
        },
        {
          "command": "dimicek.branches.show",
          "when": "view == dimicek.changes",
          "group": "navigation@0"
        }
      ],
      "commandPalette": [
        {
          "command": "dimicek.changes.refresh",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.changes.groupByDirectory",
          "when": "dimicek.hasRepository && !dimicek.changes.groupedByDirectory"
        },
        {
          "command": "dimicek.changes.showFlat",
          "when": "dimicek.hasRepository && dimicek.changes.groupedByDirectory"
        },
        {
          "command": "dimicek.changes.showDiff",
          "when": "false"
        },
        {
          "command": "dimicek.changes.openFile",
          "when": "false"
        },
        {
          "command": "dimicek.changes.rollback",
          "when": "false"
        },
        {
          "command": "dimicek.changes.addToVcs",
          "when": "false"
        },
        {
          "command": "dimicek.changes.ignore",
          "when": "false"
        },
        {
          "command": "dimicek.changes.delete",
          "when": "false"
        },
        {
          "command": "dimicek.branches.show",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.branches.newBranch",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.branches.checkoutRevision",
          "when": "dimicek.hasRepository"
        },
        {
          "command": "dimicek.branches.fetch",
          "when": "dimicek.hasRepository"
        }
      ],
      "view/item/context": [
        {
          "command": "dimicek.changes.rollback",
          "when": "view == dimicek.changes && viewItem =~ /^file:(modified|added|deleted|renamed)$/",
          "group": "inline"
        },
        {
          "command": "dimicek.changes.addToVcs",
          "when": "view == dimicek.changes && viewItem == file:unversioned",
          "group": "inline"
        },
        {
          "command": "dimicek.changes.showDiff",
          "when": "view == dimicek.changes && viewItem =~ /^file:/",
          "group": "navigation@1"
        },
        {
          "command": "dimicek.changes.openFile",
          "when": "view == dimicek.changes && viewItem =~ /^file:(modified|added|renamed|unversioned|conflicted)$/",
          "group": "navigation@2"
        },
        {
          "command": "dimicek.changes.rollback",
          "when": "view == dimicek.changes && viewItem =~ /^(file:(modified|added|deleted|renamed)|group:changes|directory:changes)$/",
          "group": "1_modification@1"
        },
        {
          "command": "dimicek.changes.addToVcs",
          "when": "view == dimicek.changes && viewItem =~ /^(file|group|directory):unversioned$/",
          "group": "1_modification@2"
        },
        {
          "command": "dimicek.changes.ignore",
          "when": "view == dimicek.changes && viewItem =~ /^(file|directory):unversioned$/",
          "group": "1_modification@3"
        },
        {
          "command": "dimicek.changes.delete",
          "when": "view == dimicek.changes && viewItem =~ /^file:(modified|added|renamed|unversioned|conflicted)$/",
          "group": "2_delete@1"
        }
      ]
    },
    "configuration": {
      "title": "Dimicek",
      "properties": {
        "dimicek.changes.groupByDirectory": {
          "type": "boolean",
          "default": true,
          "description": "Group files in the Changes view by directory."
        }
      }
    },
    "keybindings": [
      {
        "command": "dimicek.changes.showDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "focusedView == dimicek.changes"
      },
      {
        "command": "dimicek.changes.openFile",
        "key": "f4",
        "when": "focusedView == dimicek.changes"
      },
      {
        "command": "dimicek.changes.rollback",
        "key": "ctrl+alt+z",
        "mac": "cmd+alt+z",
        "when": "focusedView == dimicek.changes"
      },
      {
        "command": "dimicek.changes.addToVcs",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "focusedView == dimicek.changes"
      },
      {
        "command": "dimicek.changes.delete",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == dimicek.changes"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build": "npm run check-types && node esbuild.mjs && vite build --config webview-ui/vite.config.mts",
    "package": "npm run check-types && node esbuild.mjs --production && vite build --config webview-ui/vite.config.mts",
    "watch": "run-p watch:*",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project webview-ui/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "pretest:integration": "npm run build && node esbuild.mjs --tests",
    "test:integration": "vscode-test",
    "watch:webview": "vite build --config webview-ui/vite.config.mts --watch --mode development",
    "vsix": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "~1.110.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode-elements/elements": "^2.5.1",
    "@vscode-elements/react-elements": "^2.4.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
