{
  "name": "dimicek",
  "displayName": "Dimicek",
  "description": "Git & GitHub workflow inspired by IntelliJ IDEA: commit window, log with graph, branches popup and more.",
  "version": "0.0.1",
  "publisher": "dimicek",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/dimicek8/dimicek-extension-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/dimicek8/dimicek-extension-vscode/issues"
  },
  "homepage": "https://github.com/dimicek8/dimicek-extension-vscode#readme",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "github",
    "intellij",
    "log",
    "commit",
    "branches"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "dimicek.hello",
        "title": "Hello",
        "category": "Dimicek"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "build": "npm run check-types && node esbuild.mjs",
    "package": "npm run check-types && node esbuild.mjs --production",
    "watch": "run-p watch:*",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.110.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
